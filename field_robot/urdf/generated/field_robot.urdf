    <parent link="arm_wrist_2_link"/>
    <child link="arm_wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0996 -2.042830148012698e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="arm_ft_frame"/>
  <joint name="arm_wrist_3_link-ft_frame" type="fixed">
    <parent link="arm_wrist_3_link"/>
    <child link="arm_ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="arm_base"/>
  <joint name="arm_base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="arm_base_link"/>
    <child link="arm_base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="arm_flange"/>
  <joint name="arm_wrist_3-flange" type="fixed">
    <parent link="arm_wrist_3_link"/>
    <child link="arm_flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="arm_tool0"/>
  <joint name="arm_flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="arm_flange"/>
    <child link="arm_tool0"/>
  </joint>
  <!-- ============ ros2_control HARDWARE ============ -->
  <!--
      initial_value sets the pose the arm holds at startup. A folded pose is
      important: if the arm starts fully stretched out it can hit the ground
      or tip the base over on the first physics step.
    -->
  <ros2_control name="arm_hardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="arm_shoulder_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_shoulder_lift_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_wrist_1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_wrist_2_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-1.57</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="arm_wrist_3_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <!-- ============ GAZEBO CONTROL PLUGIN ============ -->
  <!-- This is what starts controller_manager inside the simulation. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/alpaca/ros2_ws/install/field_robot/share/field_robot/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <!-- per finger -->
  <!-- ============ PALM ============ -->
  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.06 0.1 0.05"/>
      </geometry>
      <material name="gripper_grey">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0007"/>
    </inertial>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <parent link="arm_tool0"/>
    <child link="gripper_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.025"/>
  </joint>
  <link name="gripper_left_finger_link">
    <visual>
      <geometry>
        <box size="0.02 0.015 0.07"/>
      </geometry>
      <material name="finger_dark">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.015 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="gripper_left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger_link"/>
    <!-- fingers start closed, sitting just below the palm -->
    <origin rpy="0 0 0" xyz="0 0 0.060000000000000005"/>
    <axis xyz="0 1 0"/>
    <limit effort="60.0" lower="0.0" upper="0.04" velocity="0.15"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>
  <!-- high friction so grasped objects do not slip out -->
  <gazebo reference="gripper_left_finger_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.002</minDepth>
  </gazebo>
  <link name="gripper_right_finger_link">
    <visual>
      <geometry>
        <box size="0.02 0.015 0.07"/>
      </geometry>
      <material name="finger_dark">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.015 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="gripper_right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger_link"/>
    <!-- fingers start closed, sitting just below the palm -->
    <origin rpy="0 0 0" xyz="0 0 0.060000000000000005"/>
    <axis xyz="0 -1 0"/>
    <limit effort="60.0" lower="0.0" upper="0.04" velocity="0.15"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>
  <!-- high friction so grasped objects do not slip out -->
  <gazebo reference="gripper_right_finger_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.002</minDepth>
  </gazebo>
  <!-- ============ GRASP FRAME ============ -->
  <!-- The frame MoveIt will aim at when picking. Sits between the fingertips. -->
  <link name="grasp_frame"/>
  <joint name="grasp_frame_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="grasp_frame"/>
    <origin rpy="0 0 0" xyz="0 0 0.095"/>
  </joint>
  <!-- ============ ros2_control ============ -->
  <ros2_control name="gripper_hardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="gripper_left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="gripper_right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>
