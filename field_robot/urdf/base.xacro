<?xml version="1.0"?>
<!--
  base.xacro
  Four-wheel skid-steer mobile base (Husky-like) with a 2D lidar and an IMU.
  The manipulator is mounted on "top_plate".
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mobile_base">

    <!-- ===================== PARAMETERS ===================== -->
    <xacro:property name="body_length" value="0.80"/>
    <xacro:property name="body_width"  value="0.55"/>
    <xacro:property name="body_height" value="0.25"/>
    <xacro:property name="body_mass"   value="35.0"/>

    <xacro:property name="wheel_radius" value="0.16"/>
    <xacro:property name="wheel_width"  value="0.10"/>
    <xacro:property name="wheel_mass"   value="2.5"/>

    <xacro:property name="wheel_x" value="0.28"/>
    <xacro:property name="wheel_y" value="${body_width/2 + wheel_width/2}"/>

    <xacro:property name="PI" value="3.14159265359"/>

    <!-- ===================== INERTIA MACROS ===================== -->
    <xacro:macro name="box_inertia" params="m x y z">
      <inertial>
        <mass value="${m}"/>
        <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
                 iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
                 izz="${m*(x*x+y*y)/12.0}"/>
      </inertial>
    </xacro:macro>

    <xacro:macro name="wheel_inertia" params="m r h">
      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <mass value="${m}"/>
        <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
                 iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
                 izz="${m*r*r/2.0}"/>
      </inertial>
    </xacro:macro>

    <!-- ===================== CORE LINKS ===================== -->
    <link name="base_footprint"/>

    <link name="base_link">
      <visual>
        <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
        <material name="chassis_yellow"><color rgba="0.85 0.65 0.10 1.0"/></material>
      </visual>
      <collision>
        <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      </collision>
      <xacro:box_inertia m="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child  link="base_link"/>
      <origin xyz="0 0 ${wheel_radius + body_height/2 - 0.03}" rpy="0 0 0"/>
    </joint>

    <!-- mounting plate for the manipulator -->
    <link name="top_plate">
      <visual>
        <geometry><box size="0.40 0.40 0.02"/></geometry>
        <material name="plate_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
      </visual>
      <collision>
        <geometry><box size="0.40 0.40 0.02"/></geometry>
      </collision>
      <xacro:box_inertia m="1.0" x="0.40" y="0.40" z="0.02"/>
    </link>

    <joint name="top_plate_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="top_plate"/>
      <origin xyz="-0.05 0 ${body_height/2 + 0.01}" rpy="0 0 0"/>
    </joint>

    <!-- ===================== WHEELS ===================== -->
    <xacro:macro name="wheel" params="name x y">
      <link name="${name}_wheel_link">
        <visual>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
          <material name="tyre_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
          <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </link>

      <joint name="${name}_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child  link="${name}_wheel_link"/>
        <origin xyz="${x} ${y} ${-body_height/2 + 0.03}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.2" friction="0.1"/>
      </joint>

      <gazebo reference="${name}_wheel_link">
        <mu1>1.2</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
      </gazebo>
    </xacro:macro>

    <xacro:wheel name="front_left"  x="${wheel_x}"  y="${wheel_y}"/>
    <xacro:wheel name="front_right" x="${wheel_x}"  y="${-wheel_y}"/>
    <xacro:wheel name="rear_left"   x="${-wheel_x}" y="${wheel_y}"/>
    <xacro:wheel name="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

    <!-- ===================== LIDAR ===================== -->
    <link name="lidar_link">
      <visual>
        <geometry><cylinder radius="0.05" length="0.06"/></geometry>
        <material name="sensor_dark"><color rgba="0.15 0.15 0.18 1.0"/></material>
      </visual>
      <collision><geometry><cylinder radius="0.05" length="0.06"/></geometry></collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00025"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="lidar_link"/>
      <origin xyz="0.30 0 ${body_height/2 + 0.04}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

    <!-- ===================== IMU ===================== -->
    <link name="imu_link">
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="imu_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <topic>imu</topic>
        <update_rate>50</update_rate>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on>
      </sensor>
    </gazebo>

    <!-- ===================== GAZEBO SYSTEMS ===================== -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>${2*wheel_y}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <max_linear_acceleration>2.0</max_linear_acceleration>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>

      <!--
        Publishes ONLY the wheel joints. The arm joints are published by
        joint_state_broadcaster (ros2_control), so listing them here too
        would create two publishers on /joint_states.
      -->
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
